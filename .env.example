# MongoDB connection used by application records and GridFS.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Server-side session signing secret. Use a strong random value and keep it stable per environment.
JWT_SECRET=replace-with-a-strong-random-secret

# HMAC secret for OTP challenges and OTP/IP rate-limit keys. Must be at least 32 characters.
OTP_HASH_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Gmail SMTP transport used for OTP and transactional notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=WRITING-XPRESS <your-gmail-address@gmail.com>

# Public app origin used to build email action links.
# For local development use http://localhost:3000; production must use the final HTTPS origin.
APP_BASE_URL=https://your-production-domain.example

# Mailbox for admin operational notifications.
ADMIN_NOTIFICATION_EMAIL=admin-notifications@example.com

# Admin login configuration. Store a bcrypt cost-12 hash, never a plaintext password.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-bcrypt-cost-12-hash

# Shared authorization secret for the Vercel Cron routes.
CRON_SECRET=replace-with-a-long-random-cron-secret
